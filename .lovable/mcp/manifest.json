{
  "version": 1,
  "sdk_version": "0.26.2",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://xvrsqpibubzlvsgvvpgi.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "edusphere-platform",
      "version": "0.1.0",
      "title": "EduSphere Platform"
    },
    "tools": [
      {
        "name": "list_classes",
        "title": "List classes",
        "description": "List the school's classes with section, room, academic year and class id.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_students",
        "title": "List students",
        "description": "Search the student directory. Optionally filter by name/admission number, class id, or enrolment status.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "search": {
              "description": "Match against student name or admission number.",
              "type": "string"
            },
            "class_id": {
              "description": "Only students in this class.",
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "status": {
              "description": "Enrolment status filter.",
              "type": "string",
              "enum": [
                "active",
                "inactive",
                "suspended"
              ]
            },
            "limit": {
              "description": "Max rows to return (default 25).",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_student",
        "title": "Get student",
        "description": "Fetch one student's full record by student id or admission number.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "student_id": {
              "description": "Student id (uuid).",
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "admission_no": {
              "description": "Admission number.",
              "type": "string",
              "minLength": 1
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "attendance_summary",
        "title": "Attendance summary",
        "description": "Summarise attendance for a class on a given date (counts of present, absent, late, excused) with per-student rows.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "class_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "Class to summarise."
            },
            "date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Session date in YYYY-MM-DD format."
            },
            "period": {
              "description": "Period label, e.g. 'Full Day'. Defaults to all periods.",
              "type": "string"
            }
          },
          "required": [
            "class_id",
            "date"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "mark_attendance",
        "title": "Mark attendance",
        "description": "Mark or update a student's attendance status for a class session (creating the session if needed). Changes are recorded in the audit log.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "class_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "Class the session belongs to."
            },
            "student_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "Student to mark."
            },
            "date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Session date in YYYY-MM-DD format."
            },
            "period": {
              "default": "Full Day",
              "description": "Period label, e.g. 'Full Day'.",
              "type": "string",
              "minLength": 1
            },
            "status": {
              "type": "string",
              "enum": [
                "present",
                "absent",
                "late",
                "excused"
              ],
              "description": "Attendance status."
            }
          },
          "required": [
            "class_id",
            "student_id",
            "date",
            "status"
          ]
        },
        "outputSchema": null
      }
    ]
  }
}
